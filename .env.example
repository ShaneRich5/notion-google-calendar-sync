# Copy this file to .env and fill in the blanks.

# Notion internal integration secret (https://www.notion.so/profile/integrations)
NOTION_TOKEN=

# Your "tasks" data source. This is already the right ID for your database.
NOTION_DATA_SOURCE_ID=493101e3-fc1d-403b-9957-0be55bf4baaf

# Which Google calendar to write to. This sync signs in as a service account, which
# has no calendar of its own — set this to the calendar you shared with it: usually
# just your Gmail address, or a dedicated calendar's ID from Settings > Integrate
# calendar (looks like abc123@group.calendar.google.com). NOT "primary" (see README).
GOOGLE_CALENDAR_ID=

# --- Optional settings (defaults shown) ---

# false = Notion is the only source of truth; edits made in Google are overwritten.
# TWO_WAY_SYNC=true

# Length of events for tasks that have a start time but no end time.
# DEFAULT_EVENT_MINUTES=60

# How often --watch mode syncs.
# SYNC_INTERVAL_SECONDS=300

# Zone for Notion times without a UTC offset. Defaults to this computer's zone.
# TIMEZONE=America/New_York

# Statuses that count as complete; their events get the status as a title prefix.
# COMPLETED_STATUSES=✅,♲

# Notion property names, if you rename any of them.
# NOTION_PROP_TITLE=Task name
# NOTION_PROP_DATE=Due
# NOTION_PROP_CHECKBOX=Sync to Calendar
# NOTION_PROP_EVENT_ID=GCal Event ID
# NOTION_PROP_STATUS=Status
# NOTION_PROP_PRIORITY=Priority
# NOTION_PROP_TAGS=Tags

# Google service account key file, relative to this folder.
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
